# ---- Conexao ----
REDIS_URL=redis://redis:6379/0

# ---- Fonte dos nodes (dentro do container, via volume ./data:/data) ----
NODES_FILE=/data/nodes_resultado.json
SEED_FALLBACK=/data/nodes_seed.txt

# ---- Cadencia de medicao ----
PROBE_INTERVAL=15          # segundos entre cada ciclo de medicao
SAMPLES_PER_CYCLE=3        # quantos probes por node a cada ciclo
WINDOW=600                 # amostras mantidas por node (cap do buffer)
CONCURRENCY=80             # nodes testados em paralelo
TIMEOUT=5                  # timeout por chamada (s)
RECHECK_META=600           # re-detecta chainId/archive/ws a cada N seg

# ---- Janela de tempo (medicao "safe") ----
RANK_WINDOW_SEC=900        # percentil calculado sobre os ultimos N seg (900 = 15 min)
MIN_WINDOW_SEC=900         # so ranqueia node apos observa-lo por N seg (900 = 15 min)

# ---- Regras de ranking ----
MIN_SAMPLES=3              # so ranqueia com pelo menos N amostras (entra no 1o ciclo!)
MAX_LAG=50                 # lag maximo de bloco pra ser "saudavel"
COHERENCE_BLOCKS=15000000  # bloco a >15M da mediana = OUTRA chain (impostor). Atraso normal e' tratado por MAX_LAG
MIN_SUCCESS=0.5            # success_rate minimo (0-1)
TOP_N=20                   # quantos melhores guardar em rpc:best:{net}
PUBLISH_EVERY=1            # publica no redis a cada N ciclos
TARGET_NETS=eth,bsc,base   # redes que vao pro redis

# ---- Auto-heal (anti-travamento) ----
SESSION_RECYCLE_SEC=1800   # recria a aiohttp.ClientSession a cada N seg (30min)
STALE_RESET_CYCLES=5       # se N ciclos seguidos com 0 amostras, recria session na hora
LOG_EVERY_N_ERRORS=200     # loga 1 a cada N erros do mesmo tipo (sem inundar log)
